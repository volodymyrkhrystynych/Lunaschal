# Copy this file to .env and fill in your values.

# ── LLM provider (pick one, or configure via the Settings UI) ──────────────
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ── Voice assistant backends ───────────────────────────────────────────────
# local  → faster-whisper (GPU) + kokoro-onnx (CPU); run: bash stt/setup.sh
# openai → OpenAI Whisper + TTS API;                 run: bash stt/setup.sh --api
STT_BACKEND=openai
TTS_BACKEND=openai

# OpenAI TTS voice: alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=nova

# ── Local STT options (only used when STT_BACKEND=local) ───────────────────
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cuda

# ── Listener hotkeys (evdev keycodes) ─────────────────────────────────────
# STT_PASTE_KEY=KEY_F1
# STT_VOICE_KEY=KEY_RIGHTALT

# ── Wake word (optional) ───────────────────────────────────────────────────
# WAKE_WORD_MODEL=stt/models/hey_luna.onnx
# WAKE_WORD_THRESHOLD=0.5

# ── Server ─────────────────────────────────────────────────────────────────
# PORT=3000
# DATABASE_URL=./data/lunaschal.db
# JWT_SECRET=change-me-in-production

# ── Torrents ───────────────────────────────────────────────────────────────
# Where downloads land. Must name the same directory as TORRENT_DOWNLOAD_DIR in
# torrent/.env — it is bind-mounted into the client as /downloads, and the two
# sides of that mount have to agree or the app serves paths nothing wrote to.
# Left unset it defaults to ./data/torrents, which is fine for dev but wrong for
# a machine whose root disk is nearly full.
# TORRENT_ROOT=/media/expansion/torrents

# Full newspaper PDFs. Keep this directory and the database backed up together.
# Defaults to NEWSPAPERS_ROOT (./data/newspapers). No automatic deletion.
# NEWSPAPERS_ARCHIVE_ROOT=/media/expansion/newspapers
# Subscriber browser state; created by python -m backend.newspapers.pressreader login.
# Keep it private and outside the repository's tracked files.
# PRESSREADER_SESSION_PATH=./data/pressreader/session.json
