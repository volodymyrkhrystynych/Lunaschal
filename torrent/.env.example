# Copy to torrent/.env and fill in. The real .env is gitignored (the bare
# `.env` line in the repo root .gitignore matches at any depth).
#
# The WireGuard key deliberately does NOT live in the Lunaschal database:
# that DB is ~3G, is rsynced to the backup drive nightly, and
# scripts/seed_test_db.py ships in a public repo. A gitignored env file next
# to the compose that consumes it is the smaller blast radius.

# From https://account.proton.me/u/0/vpn/WireGuard
#   - tick "NAT-PMP (Port Forwarding)"
#   - pick a P2P-designated server
# then copy the `PrivateKey` line out of the generated config.
WIREGUARD_PRIVATE_KEY=

# Comma-separated. Must be countries with P2P + port-forwarding servers.
SERVER_COUNTRIES=Canada

# Host directory that becomes /downloads inside the client. Must match
# TORRENT_ROOT in the Lunaschal server's environment.
TORRENT_DOWNLOAD_DIR=/media/expansion/torrents

TZ=America/Toronto
