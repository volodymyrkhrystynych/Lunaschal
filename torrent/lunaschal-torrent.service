# systemd --user unit for the VPN-isolated torrent stack, mirroring
# ../searxng/lunaschal-searxng.service so every Compose-managed piece of
# Lunaschal starts the same way.
#
# Install:
#   cp torrent/.env.example torrent/.env   # then fill in WIREGUARD_PRIVATE_KEY
#   mkdir -p ~/.config/systemd/user
#   ln -sf ~/workspace/Lunaschal/torrent/lunaschal-torrent.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lunaschal-torrent
#
# First start: linuxserver/qbittorrent generates a temporary WebUI password and
# prints it to its log —
#   docker logs qbittorrent 2>&1 | grep -i 'temporary password'
# Set a real one in the WebUI, then put the credentials into
# Lunaschal's Settings → Torrent.
#
# Type=oneshot + RemainAfterExit=yes rather than exec'ing a foreground process:
# `docker compose up -d` detaches immediately and Docker's own
# `restart: unless-stopped` supervises from there, so systemd's job is "make
# sure this ran once at login/boot", not "keep a process alive".
#
# No After=/Requires=docker.service — that's a *system* unit and invisible to
# the --user manager. Same reasoning as the SearXNG unit: plain
# network-online.target ordering plus the ConditionPathExists guard is enough.
#
# Note `loginctl show-user volodya -p Linger` is currently `Linger=no`, so this
# unit only runs while a session is open. The containers themselves are
# supervised by the system-wide Docker daemon and keep running after logout —
# only the "bring it up at boot" step depends on lingering.
[Unit]
Description=VPN-isolated torrent stack for Lunaschal
After=network-online.target
ConditionPathExists=/var/run/docker.sock
# The downloads bind-mount lives on an x-systemd.automount exFAT volume.
# Starting the stack before it is mounted would bind an empty directory and
# every torrent would write into a phantom that vanishes on the next mount.
RequiresMountsFor=/media/expansion

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/workspace/Lunaschal/torrent
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=default.target
