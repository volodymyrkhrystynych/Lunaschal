# systemd --user unit for Lunaschal's llama-server.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   ln -sf "$PWD/llama/lunaschal-llama.service" ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now lunaschal-llama
#
# The point of running it as a unit rather than from start.sh: the model survives
# Flask restarts, terminal closes, and `npm run dev` reloads. Loading Qwen3.6 35B
# takes tens of seconds, so anything that reloads it per backend restart is
# unusable in practice.

[Unit]
Description=llama-server (router mode) for Lunaschal
After=network.target

[Service]
Type=exec
ExecStart=%h/workspace/Lunaschal/llama/start-llama.sh
Restart=on-failure
RestartSec=5
# The routed experts live in system RAM (~13 GB) and are read on every token. If
# the kernel pages them out, generation speed collapses, so ask to be the last
# thing swapped rather than the first.
OOMPolicy=continue
Environment=LLAMA_CACHE=%h/.cache/llama.cpp

[Install]
WantedBy=default.target
