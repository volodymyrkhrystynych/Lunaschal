# Copy to ops/backup.env and fill in (gitignored, same convention as .env).

# 4TB external HDD, mounted at a stable path — see docs/deployment.md for the
# fstab/udev-based mount setup (drive letter/label enumeration isn't reliable
# across reconnects). Leave blank to skip the HDD destination.
BACKUP_HDD_PATH=/mnt/backup-hdd/lunaschal

# Always-on tablet, reached over its Tailscale MagicDNS hostname (stable
# regardless of LAN vs away — same convention as TAILSCALE_HOSTNAME elsewhere
# in this project). Leave BACKUP_TABLET_HOST blank to skip the tablet
# destination. Needs passwordless SSH set up — see docs/deployment.md.
BACKUP_TABLET_HOST=
BACKUP_TABLET_USER=
BACKUP_TABLET_PATH=/home/volodya/lunaschal-backups

# How many daily snapshots to keep at each destination.
BACKUP_RETENTION_DAYS=14
