# Copy to ops/backup.env and fill in (gitignored, same convention as .env).

# External HDD. This is a directory *on* the drive — the script tests the mount
# point above it to decide whether the drive is present, so point it one level
# inside the mount. Leave blank to skip the HDD destination.
#
# The udisks auto-mount path (/run/media/<user>/<label>/...) works and is what
# this machine uses; a stable fstab UUID mount is still preferable if you ever
# want the backup to run without a desktop session having mounted the drive.
# See docs/deployment.md.
BACKUP_HDD_PATH=/run/media/volodya/Expansion/lunaschal

# Always-on tablet, reached over its Tailscale MagicDNS hostname (stable
# regardless of LAN vs away — same convention as TAILSCALE_HOSTNAME elsewhere
# in this project). Leave BACKUP_TABLET_HOST blank to skip the tablet
# destination. Needs passwordless SSH set up — see docs/deployment.md.
BACKUP_TABLET_HOST=
BACKUP_TABLET_USER=
BACKUP_TABLET_PATH=/home/volodya/lunaschal-backups

# How many dated DB snapshots to keep at each destination. This governs the
# db/ tier only — the media mirror is additive and is never pruned, so nothing
# here can delete a fic or a recording from a backup.
BACKUP_RETENTION_DAYS=14
